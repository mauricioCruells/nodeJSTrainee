{
  "compilerOptions": {
    "target": "es2016",                                  
    "module": "commonjs",                               
    "rootDir": "./src",                                  
    "moduleResolution": "node",                       
    "outDir": "bin",                             
    "esModuleInterop": true,                
    "forceConsistentCasingInFileNames": true,       
    "strict": true,                           
    "noImplicitAny": true,                 
    "alwaysStrict": true,  
    "skipLibCheck": true                   
  },
  "include": ["src"],
  "exclude": ["node_modules", "bin"]
}
