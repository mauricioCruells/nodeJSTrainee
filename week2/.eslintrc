{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "import",
    "prettier"
  ],
   "parserOptions": {
    "project": "./tsconfig.eslint.json"
  },
  "extends": [
    "airbnb-typescript/base"
  ],
  "rules": {
    "@typescript-eslint/no-var-requires" : "off",
    "@typescript-eslint/no-useless-constructor" : "off"
  }
}